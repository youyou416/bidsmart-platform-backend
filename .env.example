# 示例只包含公开配置；Spring Boot 不会自动加载此文件。
# 仅可在隔离的回环 dev 环境使用下面的本机数据库参数。
APP_ENV=dev
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
DB_HOST=127.0.0.1
DB_PORT=2881
DB_NAME=hr_score_dev
DB_USERNAME=root@sys
# 明确表示隔离本机研发不启用数据库 TLS，不得用于远程/生产。
# 支持 TLS 的数据库请使用 VERIFY_IDENTITY 并配置可信证书。
DB_SSL_MODE=DISABLED
DB_POOL_MAX=10
# DB_PASSWORD 必须在本机通过受控环境/秘密文件注入；这里不设默认值。
# DB_PASSWORD=
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=8h
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW=15m
LOGIN_LOCKOUT=15m
AUDIT_RETENTION_DAYS=30
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
TRANSPORT_VERIFIED=false
PUBLIC_SYSTEM_NAME='智能化竞价采购平台 · 基础框架'
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_ROLE_ID=1001
BOOTSTRAP_ADMIN_DEPARTMENT_ID=1001
# 仅首次显式初始化时提供，完成后移除；不存在固定初始账号/密码。
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=

# Login graphic captcha (requires V002 migration first)
PLATFORM_CAPTCHA_TTL=2m
PLATFORM_CAPTCHA_REQUESTSPERMINUTE=20
